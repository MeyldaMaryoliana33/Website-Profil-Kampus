:root {
  --pink: #f6b6cf;
  --pink-tua: #d9628f;
  --muda: #fff0f6;
  --judul: #a8316a;
  --teks: #4a2a3a;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; line-height: 1.6; color: var(--teks); background: #fff; }
a { color: var(--judul); text-decoration: none; }
.container { width: 90%; max-width: 1000px; margin: 0 auto; }


header { background: var(--pink); }
header .container { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; }
.logo { padding: 14px 0; font-size: 20px; font-weight: bold; color: var(--teks); }
nav ul { margin: 0; padding: 0; list-style: none; display: flex; }
nav li > a { display: block; padding: 18px 14px; color: var(--teks); }
nav li > a:hover { background: var(--muda); }


.banner { padding: 36px 0; border-bottom: 1px solid var(--pink); }
.banner p { margin: 0; font-size: 14px; }
.banner a { text-decoration: underline; }
.banner h1 { margin: 6px 0 0; font-size: 30px; color: var(--judul); }


.kotak { max-width: 700px; margin: 30px auto; padding: 24px; border: 1px solid var(--pink); border-radius: 6px; }
h2 { margin: 28px 0 0; padding-bottom: 6px; font-size: 20px; color: var(--judul); border-bottom: 2px solid var(--pink); }
h2:first-child { margin-top: 0; }
label { display: block; margin-top: 14px; font-weight: 600; }
input[type=text], input[type=date], input[type=tel], input[type=email], select, textarea {
  width: 100%; padding: 8px; font: inherit; color: var(--teks);
  border: 1px solid #d9b3c4; border-radius: 4px;
}
input:focus, select:focus, textarea:focus { outline: 2px solid var(--pink-tua); border-color: var(--pink-tua); }
.radio label { display: inline; margin-right: 16px; font-weight: normal; }
.setuju { margin-top: 20px; font-weight: normal; }
.error { display: block; min-height: 0; font-size: 13px; color: #c00; }
#petunjukUsia { display: block; margin-top: 2px; color: #8a6a7a; }


.filebox { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 4px; }
.pilih-file {
  display: inline-block; margin: 0; padding: 7px 16px; font-weight: 600; font-size: 15px;
  color: var(--teks); background: var(--pink); border: 1px solid var(--pink-tua);
  border-radius: 4px; cursor: pointer;
}
.pilih-file:hover { background: var(--muda); }
.filebox input:focus-visible + .pilih-file { outline: 2px solid var(--pink-tua); outline-offset: 2px; }
.chip { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: #8a6a7a; }
.chip.ada { padding: 3px 4px 3px 12px; background: var(--muda); border: 1px solid var(--pink); border-radius: 99px; }
.chip a { max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-decoration: underline; }
.silang {
  width: 24px; height: 24px; padding: 0; font-size: 18px; line-height: 1;
  color: #fff; background: #c00; border: 0; border-radius: 50%; cursor: pointer;
}
.silang:hover { background: #900; }


.aksi { margin-top: 24px; display: flex; gap: 10px; flex-wrap: wrap; }
.aksi.tengah { justify-content: center; }
.tombol {
  display: inline-block; padding: 10px 22px; font: inherit; font-size: 16px; color: var(--teks);
  background: var(--pink); border: 1px solid var(--pink-tua); border-radius: 4px; cursor: pointer;
}
.tombol:hover { background: var(--muda); color: var(--teks); }
.tombol.putih { background: #fff; }
.tombol.putih:hover { background: var(--muda); }


.sukses { padding: 40px 24px; text-align: center; }
.sukses .centang {
  display: grid; place-items: center; width: 64px; height: 64px; margin: 0 auto 14px;
  font-size: 34px; color: #fff; background: #2e9e5b; border-radius: 50%;
}
.sukses h2 { margin: 0; padding: 0; font-size: 26px; border: 0; }
.sukses p { margin: 8px 0 0; }


table { width: 100%; border-collapse: collapse; }
.kotak h2 + table { margin-top: 14px; }
td { padding: 10px; border: 1px solid #f0cddb; word-break: break-word; }
.hasil td:first-child { width: 35%; font-weight: 600; background: var(--muda); }
.hasil a { text-decoration: underline; }

footer { padding: 24px 0; text-align: center; color: var(--teks); background: var(--pink); }

@media (max-width: 700px) {
  nav ul { flex-wrap: wrap; }
  .banner h1 { font-size: 24px; }
  .kotak { padding: 16px; }
}


